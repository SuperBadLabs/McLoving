# McLoving controller: public API, agent-control mTLS plane, embedded worker
# (deployed with the embedded worker disabled via a never-requested
# capability), and migrate-at-boot with the dedicated migration role.
#
# Install to ~/.config/systemd/user/ for the mcloving service user.

[Unit]
Description=McLoving controller (public API + agent control plane)
Requires=mcloving-db-init.service
After=mcloving-db-init.service mcloving-postgres.service

[Service]
# EXECUTION HOOKS ARE STRIPPED BEFORE ANY OF THIS UNIT'S PROCESSES START.
# bash sources BASH_ENV before the first line of a script, and the dynamic
# loader runs an LD_PRELOAD constructor before main(), so the pre-start
# guard cannot defend itself from inside itself -- by the time its code
# runs, the hook has already executed. systemd applies UnsetEnvironment= to
# the composed environment before exec, which beats a manager-level value
# and one this unit's own EnvironmentFile= declares alike. Validation
# refuses such a declaration as well; this is the layer that protects the
# guard itself.
UnsetEnvironment=BASH_ENV ENV SHELLOPTS BASHOPTS LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GLIBC_TUNABLES PYTHONSTARTUP PYTHONPATH PERL5OPT PERL5LIB RUBYOPT NODE_OPTIONS
Type=exec
# EnvironmentFile without "-" fails the unit when the contract file is absent.
EnvironmentFile=%h/.config/mcloving/controller.env
# Fail fast on unset or placeholder variables before the binary starts.
ExecStartPre=%h/.local/libexec/mcloving/helpers/mcloving-env-guard controller %h/.config/mcloving/controller.env
ExecStart=%h/.local/libexec/mcloving/current/mcloving-controller
# Startup succeeds only once the public API answers; otherwise the unit fails.
ExecStartPost=%h/.local/libexec/mcloving/helpers/mcloving-health controller %h/.config/mcloving/controller.env
Restart=on-failure
RestartSec=2
TimeoutStartSec=120
# Named state directory: %h/.local/state/mcloving-controller holds the
# artifact object root and the disabled embedded worker's journal/workspace.
StateDirectory=mcloving-controller
# Controller state is private to the service user for the same reason as
# the agent's: StateDirectory defaults to 0755 and created files would
# otherwise follow the ambient umask.
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
