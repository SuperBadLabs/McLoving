# McLoving database bootstrap: schema migration plus tenant/organization
# provisioning. Runs after PostgreSQL is healthy and before the controller.
#
# Install to ~/.config/systemd/user/ for the mcloving service user.

[Unit]
Description=McLoving database bootstrap (migrate, tenant role, organization)
Requires=mcloving-postgres.service
After=mcloving-postgres.service

[Service]
# EXECUTION HOOKS ARE STRIPPED BEFORE ANY OF THIS UNIT'S PROCESSES START.
# bash sources BASH_ENV before the first line of a script, and the dynamic
# loader runs an LD_PRELOAD constructor before main(), so the pre-start
# guard cannot defend itself from inside itself -- by the time its code
# runs, the hook has already executed. systemd applies UnsetEnvironment= to
# the composed environment before exec, which beats a manager-level value
# and one this unit's own EnvironmentFile= declares alike. Validation
# refuses such a declaration as well; this is the layer that protects the
# guard itself.
UnsetEnvironment=BASH_ENV ENV SHELLOPTS BASHOPTS LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GLIBC_TUNABLES PYTHONSTARTUP PYTHONPATH PERL5OPT PERL5LIB RUBYOPT NODE_OPTIONS PYTHONUSERBASE PYTHONHOME
# PATH IS PINNED AT THIS BOUNDARY, never inherited from the service manager.
# Every pre-start helper below is a script, and the KERNEL resolves its
# interpreter before a single line of guard code runs -- so a manager PATH
# carrying a group- or world-writable directory ahead of /usr/bin lets
# another local user supply that interpreter and execute code as the service
# account on the next start, with the guard's own process already
# compromised by the time it could object. Round 41 established exactly this
# reasoning for the children this lane spawns ("resolving by name through an
# inherited PATH is the same defect one level down") and gave them a fixed
# trusted PATH; this is that defect at the unit boundary, which that round
# did not reach.
#
# This directive is NOT the last word, and must not be mistaken for it:
# EnvironmentFile= overrides Environment= REGARDLESS OF DECLARATION ORDER --
# verified on systemd 255, where a file assignment won both above and below
# this line. So the shipped helpers additionally name an ABSOLUTE
# interpreter in their shebangs, and the contract allowlist refuses a
# declared PATH outright. Three layers, because any one of them alone leaves
# a door.
#
# The value is MCLOVING_TRUSTED_PATH from deploy/bin/mcloving-deploy-lib.sh.
# deploy/test-deployment.sh fails if the two drift.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Type=oneshot
RemainAfterExit=yes
NoNewPrivileges=yes
# EnvironmentFile without "-" fails the unit when the contract file is absent.
EnvironmentFile=%h/.config/mcloving/db-init.env
ExecStartPre=%h/.local/libexec/mcloving/helpers/mcloving-env-guard db-init %h/.config/mcloving/db-init.env
ExecStart=%h/.local/libexec/mcloving/helpers/mcloving-db-init
TimeoutStartSec=180

[Install]
WantedBy=default.target
