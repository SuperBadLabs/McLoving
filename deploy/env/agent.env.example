# Environment contract for mcloving-agent.service.
# Copy to ~/.config/mcloving/agent.env, mode 0600, and replace every
# __SET_ME…__ placeholder. mcloving-env-guard refuses to start the service
# while any placeholder or empty value remains, and additionally checks that
# every *_PATH file below (except the journal, which the agent creates)
# exists and is readable.
# Paths below assume the service user's home is /home/mcloving; adjust to the
# actual home directory (systemd %h) of the deploying user.

# Identity claims; must match one line in the controller's
# agent-identity-bindings.txt together with this agent's certificate digest.
MCLOVING_AGENT_ID=__SET_ME_AGENT_ID__
MCLOVING_AGENT_TRUST_POOL=trusted-linux
MCLOVING_AGENT_ORGANIZATION_ID=__SET_ME_ORGANIZATION_UUID__

# Controller agent-control endpoint (MCLOVING_AGENT_LISTEN on the controller).
MCLOVING_CONTROLLER_URI=https://127.0.0.1:8443
# DNS name inside the controller server certificate's SAN.
MCLOVING_CONTROLLER_DNS_NAME=controller.internal

# Outbound mTLS material.
MCLOVING_CONTROLLER_CA_PATH=/home/mcloving/.config/mcloving/pki/controller-ca.pem
MCLOVING_AGENT_CERTIFICATE_PATH=/home/mcloving/.config/mcloving/pki/agent.pem
MCLOVING_AGENT_PRIVATE_KEY_PATH=/home/mcloving/.config/mcloving/pki/agent-key.pem

# Durable journal and workspace (inside StateDirectory=mcloving-agent).
MCLOVING_AGENT_JOURNAL_PATH=/home/mcloving/.local/state/mcloving-agent/journal.db
MCLOVING_AGENT_WORKSPACE_ROOT=/home/mcloving/.local/state/mcloving-agent/workspace

# Optional timing overrides (binary defaults shown).
#MCLOVING_AGENT_LEASE_SECONDS=30
#MCLOVING_AGENT_POLL_MILLISECONDS=500
#MCLOVING_AGENT_RENEW_MILLISECONDS=5000
#MCLOVING_AGENT_TERMINATION_GRACE_MILLISECONDS=2000
