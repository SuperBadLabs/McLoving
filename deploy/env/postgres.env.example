# Environment contract for mcloving-postgres.service (quadlet container).
# Copy to ~/.config/mcloving/postgres.env, mode 0600, and replace every
# __SET_ME…__ placeholder. mcloving-env-guard refuses to start the service
# while any placeholder or empty value remains.

# Superuser role for the database. The migration role in the controller's
# MCLOVING_MIGRATION_DATABASE_URL must match this user and password.
POSTGRES_USER=mcloving
POSTGRES_DB=mcloving
POSTGRES_PASSWORD=__SET_ME_POSTGRES_SUPERUSER_PASSWORD__
