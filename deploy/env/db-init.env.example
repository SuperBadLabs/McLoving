# Environment contract for mcloving-db-init.service (oneshot bootstrap).
# Copy to ~/.config/mcloving/db-init.env, mode 0600, and replace every
# __SET_ME…__ placeholder. mcloving-env-guard refuses to run the bootstrap
# while any placeholder or empty value remains.

# Migration-role connection string. User/password must match postgres.env.
MCLOVING_MIGRATION_DATABASE_URL=postgres://mcloving:__SET_ME_POSTGRES_SUPERUSER_PASSWORD__@127.0.0.1:5432/mcloving

# Password installed on the constrained mcloving_tenant runtime role. The
# controller's MCLOVING_DATABASE_URL must use this password.
MCLOVING_TENANT_PASSWORD=__SET_ME_TENANT_PASSWORD__

# Organization and first project provisioned on first boot. The controller's
# MCLOVING_ORGANIZATION_ID must equal MCLOVING_ORGANIZATION_ID below.
MCLOVING_ORGANIZATION_ID=__SET_ME_ORGANIZATION_UUID__
MCLOVING_ORGANIZATION_SLUG=__SET_ME_ORGANIZATION_SLUG__
MCLOVING_PROJECT_ID=__SET_ME_PROJECT_UUID__
MCLOVING_PROJECT_SLUG=__SET_ME_PROJECT_SLUG__

# Container that hosts PostgreSQL; psql runs through `podman exec` so the
# host needs no PostgreSQL client. Must match ContainerName= in
# mcloving-postgres.container.
MCLOVING_POSTGRES_CONTAINER=mcloving-postgres
MCLOVING_POSTGRES_SUPERUSER=mcloving
MCLOVING_POSTGRES_DB=mcloving
