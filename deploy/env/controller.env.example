# Environment contract for mcloving-controller.service.
# Copy to ~/.config/mcloving/controller.env, mode 0600, and replace every
# __SET_ME…__ placeholder. mcloving-env-guard refuses to start the service
# while any placeholder or empty value remains, and additionally enforces:
#   - MCLOVING_MIGRATION_DATABASE_URL differs from MCLOVING_DATABASE_URL
#   - MCLOVING_API_TOKEN and MCLOVING_ARTIFACT_AGENT_TOKEN are each at least
#     32 bytes and distinct from each other
#   - every *_PATH file exists and is readable
# Paths below assume the service user's home is /home/mcloving; adjust to the
# actual home directory (systemd %h) of the deploying user.

# --- Database (two distinct roles, same database) -------------------------
MCLOVING_MIGRATION_DATABASE_URL=postgres://mcloving:__SET_ME_POSTGRES_SUPERUSER_PASSWORD__@127.0.0.1:5432/mcloving
MCLOVING_DATABASE_URL=postgres://mcloving_tenant:__SET_ME_TENANT_PASSWORD__@127.0.0.1:5432/mcloving

# --- Public API -----------------------------------------------------------
MCLOVING_API_TOKEN=__SET_ME_API_BEARER_TOKEN_MINIMUM_32_BYTES__
MCLOVING_ARTIFACT_AGENT_TOKEN=__SET_ME_DISTINCT_ARTIFACT_TOKEN_MINIMUM_32_BYTES__
MCLOVING_LISTEN=127.0.0.1:8080

# --- Artifact object store (inside StateDirectory=mcloving-controller) ----
MCLOVING_OBJECT_ROOT=/home/mcloving/.local/state/mcloving-controller/objects

# --- Organization ---------------------------------------------------------
# Must equal MCLOVING_ORGANIZATION_ID in db-init.env.
MCLOVING_ORGANIZATION_ID=__SET_ME_ORGANIZATION_UUID__

# --- Embedded worker (required by the binary; deployed disabled) ----------
# The capability "disabled" is never requested by submissions, so the
# embedded worker claims nothing; real work runs on the remote agent.
MCLOVING_AGENT_ID=embedded-disabled
MCLOVING_AGENT_CAPABILITIES=disabled
MCLOVING_AGENT_TRUST_POOL=trusted-linux
MCLOVING_LEASE_SECONDS=30
MCLOVING_POLL_MILLISECONDS=500
MCLOVING_CANCELLATION_POLL_MILLISECONDS=500
MCLOVING_TERMINATION_GRACE_MILLISECONDS=2000
MCLOVING_SESSION_EPOCH=1
MCLOVING_WORKSPACE_ROOT=/home/mcloving/.local/state/mcloving-controller/embedded-workspace
MCLOVING_AGENT_JOURNAL=/home/mcloving/.local/state/mcloving-controller/embedded-agent.db

# --- Agent control plane (mTLS server for remote agents) ------------------
MCLOVING_AGENT_LISTEN=127.0.0.1:8443
MCLOVING_AGENT_SERVER_CERT_PATH=/home/mcloving/.config/mcloving/pki/controller-server.pem
MCLOVING_AGENT_SERVER_KEY_PATH=/home/mcloving/.config/mcloving/pki/controller-server-key.pem
MCLOVING_AGENT_CLIENT_CA_PATH=/home/mcloving/.config/mcloving/pki/agent-ca.pem
# One line per enrolled agent certificate:
#   <sha256-of-DER-leaf> <agent-id> <trust-pool> <organization-uuid>
MCLOVING_AGENT_IDENTITY_BINDINGS_PATH=/home/mcloving/.config/mcloving/agent-identity-bindings.txt
