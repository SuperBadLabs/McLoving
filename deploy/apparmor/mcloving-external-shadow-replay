# The shadow replay process must consume only signed connector evidence. It
# uses an enforcing profile that leaves file access and inherited execution to
# deployment filesystem policy while explicitly denying every network family.
# The replay executable checks the exact enforcing label before loading authority;
# the protected gate proves both that direct execution fails closed and that the
# confined executable observes the live denial.
abi <abi/4.0>,
#include <tunables/global>

profile mcloving-external-shadow-replay {
  file,
  /** ix,
  deny network,
}
