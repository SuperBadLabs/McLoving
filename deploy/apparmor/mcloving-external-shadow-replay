# The shadow replay process must consume only signed connector evidence. It is
# uses an enforcing profile that leaves file access and inherited execution to
# deployment filesystem policy while explicitly denying every network family.
# Deployment opts in with aa-exec and the protected gate proves the live label
# and denial.
abi <abi/4.0>,
#include <tunables/global>

profile mcloving-external-shadow-replay {
  file,
  /** ix,
  deny network,
}
