#!/usr/bin/env bash
# Re-read every deployed McLoving implementation identity as one canonical,
# deterministic JSON document. A future authoritative-cutover freeze
# (CUTOVER-001) consumes this output to detect drift: two invocations over
# an unchanged deployment produce byte-identical documents (no timestamps,
# sorted keys, sorted paths, home-relative paths).
#
# usage: mcloving-deployed-digests [--home DIR]
#
# Covered identities:
#   ancestors         mode and owner of every directory on the lexical AND
#                     physical chain down to each walked tree; a relaxed or
#                     re-owned ancestor lets another local user rename a
#                     protected subtree aside wholesale
#   releases/*        sha256 + size of every staged binary set (all records
#                     carry mode, uid, and gid)
#   current/previous  active and rollback release symlink targets
#   units             sha256 of every installed mcloving-* unit/quadlet file
#   config            sha256 of every file under ~/.config/mcloving
#                     (environment contracts, identity bindings, PKI); the
#                     hash commits to secret-bearing files without revealing
#                     them
set -euo pipefail

home_dir="${HOME}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --home) home_dir="${2:?}"; shift 2 ;;
    *) echo "usage: mcloving-deployed-digests [--home DIR]" >&2; exit 64 ;;
  esac
done

# Anchored to the invoking directory once, up front. A relative --home
# would otherwise reach path comparisons and the ancestor walk, where
# component resolution anchored at "/" would inspect a tree that does not
# exist and validate none of the real deployment's links. Absolutization
# only -- symlink resolution stays the walk's job.
case "${home_dir}" in /*) ;; *) home_dir="${PWD%/}/${home_dir}" ;; esac

if [[ ! -d "${home_dir}/.local/libexec/mcloving" ]]; then
  echo "mcloving-deployed-digests: no deployment under ${home_dir}" >&2
  exit 1
fi

# shellcheck source=deploy/bin/mcloving-deploy-lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/mcloving-deploy-lib.sh"

# The ancestor set comes from the library's single derivation -- the same
# lexical-plus-physical chain the installer refuses on -- so the inventory
# and the refusal walk cannot drift apart. The roots listed here mirror the
# trees the document walks below. A looping or dangling ancestor link is a
# named failure: nothing behind it is readable to record.
ancestor_dirs="$(deployment_ancestor_chain "${home_dir}" \
  "${home_dir}/.local/libexec/mcloving/releases" \
  "${home_dir}/.local/libexec/mcloving/helpers" \
  "${home_dir}/.config/systemd/user" \
  "${home_dir}/.config/containers/systemd" \
  "${home_dir}/.config/mcloving" \
  "${home_dir}/.config/mcloving/pki")" || {
  echo "mcloving-deployed-digests: cannot derive the deployment ancestor chain" >&2
  exit 1
}
export MCLOVING_ANCESTOR_DIRS="${ancestor_dirs}"
# Nested symlinks are discovered only while walking, so their target chains
# are derived at that point -- through the same shared library function,
# which the document builder invokes by path.
MCLOVING_DEPLOY_LIB="$(dirname "${BASH_SOURCE[0]}")/mcloving-deploy-lib.sh"
export MCLOVING_DEPLOY_LIB

python3 - "${home_dir}" <<'PY'
import hashlib
import json
import stat
import subprocess
import sys
import os
from pathlib import Path

NODE_KINDS = {
    stat.S_IFIFO: "fifo",
    stat.S_IFSOCK: "socket",
    stat.S_IFCHR: "character_device",
    stat.S_IFBLK: "block_device",
    stat.S_IFDIR: "directory",
}

home = Path(sys.argv[1])
libexec = home / ".local/libexec/mcloving"
config = home / ".config/mcloving"
unit_dirs = (
    home / ".config/systemd/user",
    home / ".config/containers/systemd",
)


MAX_RECORD_ATTEMPTS = 3


def file_record(path: Path, root: Path) -> dict:
    # Every fact in a record comes from one non-blocking descriptor, and the
    # link target is checked on both sides of the read.
    #
    # Classifying with a stat() and then opening leaves a window: a contract
    # replaced with a FIFO in between makes the ordinary open block forever, so
    # the document is lost exactly when the drift it reports is present.
    # O_NONBLOCK returns immediately for a FIFO with no writer, and fstat on
    # the descriptor describes the thing actually opened rather than whatever
    # the path named a moment earlier.
    #
    # Reading the link separately leaves the same kind of window: a rotated
    # symlink yields the old target's bytes beside the new target's name, an
    # identity that never existed. The target is snapshotted before and
    # rechecked after; a link that moved under the read is retried.
    try:
        relative = path.relative_to(root).as_posix()
    except ValueError:
        # A physical ancestor outside the home tree -- the parent chain of a
        # symlinked root's resolved target -- has no home-relative spelling.
        # It is recorded under its absolute path: the document must pin its
        # mode all the same, or relaxing it leaves the re-read blind to the
        # one rename that swaps the whole deployment aside.
        relative = path.as_posix()

    def identity(status: os.stat_result) -> tuple:
        # Everything a record asserts about a file, plus the inode and
        # modification time that reveal an in-place change of the same size.
        return (
            status.st_dev,
            status.st_ino,
            status.st_size,
            status.st_mode,
            status.st_mtime_ns,
        )

    def link_target():
        try:
            return os.readlink(path)
        except OSError:
            return None

    def unreadable(reason: str, target: str | None) -> dict:
        # An entry that cannot be read is itself the drift worth reporting, and
        # losing the whole document to it would deny CUTOVER-001 its re-read
        # precisely while the tree is changing. The reason distinguishes a
        # withdrawn permission from a disappearance.
        record = {"path": relative, "kind": "unreadable", "reason": reason}
        if target is not None:
            record["symlink_target"] = target
        return record

    for _ in range(MAX_RECORD_ATTEMPTS):
        before = link_target()
        try:
            descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        except PermissionError:
            return unreadable("permission_denied", before)
        except OSError:
            if before is not None:
                # A target that has gone missing is exactly the drift this
                # document exists to report, so the link is recorded rather
                # than dereferenced.
                return {
                    "path": relative,
                    "symlink_target": before,
                    "kind": "dangling_symlink",
                }
            return unreadable("open_failed", before)
        try:
            status = os.fstat(descriptor)
            opened = (status.st_dev, status.st_ino)
            # The metadata snapshot the returned record was built from; the
            # regular-file branch refreshes it with its post-read fstat.
            recorded = status
            if not stat.S_ISREG(status.st_mode):
                # A FIFO, socket, device node, or directory has no content to
                # digest. A directory's mode is deployment state in its own
                # right: a config root relaxed to 0777 leaves every file record
                # byte-identical while another local user can replace the
                # contracts and keys inside it.
                kind = NODE_KINDS.get(stat.S_IFMT(status.st_mode), "unknown_node")
                if before is not None and stat.S_ISDIR(status.st_mode):
                    kind = "directory_symlink"
                record = {
                    "path": relative,
                    "kind": kind,
                    "mode": stat.S_IMODE(status.st_mode),
                    # Ownership is identity too: a directory that changes
                    # hands can be re-moded by its new owner at will, so a
                    # record omitting the owner stays byte-identical across
                    # the one change that makes every other field revocable.
                    "uid": status.st_uid,
                    "gid": status.st_gid,
                }
            else:
                digest = hashlib.sha256()
                try:
                    with os.fdopen(descriptor, "rb", closefd=False) as handle:
                        for chunk in iter(lambda: handle.read(1 << 20), b""):
                            digest.update(chunk)
                    # One descriptor is not enough on its own: a file truncated
                    # or appended in place while the read is in flight leaves
                    # the digest describing the bytes actually seen and the
                    # size describing the state before the change. Recheck the
                    # metadata that defines the identity, and retry rather than
                    # emit a pairing that never existed.
                    settled = os.fstat(descriptor)
                except PermissionError:
                    return unreadable("permission_denied", before)
                except OSError:
                    return unreadable("read_failed", before)
                if identity(settled) != identity(status):
                    continue
                recorded = settled
                record = {
                    "path": relative,
                    "sha256": digest.hexdigest(),
                    "size_bytes": settled.st_size,
                    "mode": stat.S_IMODE(settled.st_mode),
                    "executable": bool(settled.st_mode & 0o111),
                    "uid": settled.st_uid,
                    "gid": settled.st_gid,
                }
        finally:
            os.close(descriptor)
        # An atomic rename can replace the file after the open while the
        # descriptor stays perfectly stable, and neither path is a symlink, so
        # the link check above sees nothing. Without this the record reports
        # the old inode's content for a pathname that already refers to new
        # content -- a CUTOVER re-read describing stale deployment state during
        # exactly the update it is meant to observe. Compare what the pathname
        # resolves to now against what was actually opened.
        try:
            current = os.stat(path)
        except OSError:
            continue
        if (current.st_dev, current.st_ino) != opened:
            continue
        # Same inode is not same identity: a chmod or chown landing between
        # the record's fstat and this re-check leaves device and inode
        # untouched while the mode the record carries is already stale -- a
        # canonical document reporting 0700 for a directory that is 0777 by
        # the time it returns. Non-regular nodes never had a second look at
        # all; regular files only compared their own two fstats. Revalidate
        # the identity-relevant metadata against what the pathname resolves
        # to NOW, and retry on change like every other instability here.
        if (
            stat.S_IMODE(current.st_mode),
            current.st_uid,
            current.st_gid,
        ) != (
            stat.S_IMODE(recorded.st_mode),
            recorded.st_uid,
            recorded.st_gid,
        ):
            continue
        after = link_target()
        if after == before:
            if before is not None:
                record["symlink_target"] = before
            return record
    # The file or its link moved under every attempt. Reporting that is honest;
    # reporting a digest paired with a size, mode, or target it did not come
    # from is not.
    return unreadable("unstable_entry", link_target())


def walk(root: Path) -> list[Path]:
    """Every file the services can actually read beneath ``root``.

    ``rglob`` does not descend a symlinked directory, so an operator who points
    a configuration subtree such as ``pki`` at managed storage would get a
    re-read that silently omits every certificate and key inside it, while the
    services read them happily. This walks the tree the way the services see
    it, following directory links, and guards against a link cycle by
    remembering resolved directories.
    """
    found: list[Path] = []
    if root.is_dir() and not root.is_symlink():
        # The walked root is a directory whose permissions are themselves
        # deployment state, so it is recorded alongside what it contains.
        found.append(root)
    if root.is_symlink():
        # The root of a walked tree is live configuration in its own right.
        # Every nested alias is recorded below, but repointing ~/.config/mcloving
        # itself at another managed directory holding identical bytes would
        # otherwise leave this document unchanged -- a drift re-read blind to
        # the one substitution that redirects the whole tree. A root link whose
        # target is gone is likewise a fact the `is_dir()` check would drop.
        found.append(root)
    if not root.is_dir():
        return found
    seen: set = set()

    def descend(directory: Path) -> None:
        try:
            key = directory.resolve().as_posix()
        except OSError:
            return
        if key in seen:
            return
        seen.add(key)
        try:
            entries = sorted(directory.iterdir())
        except OSError:
            return
        for entry in entries:
            try:
                is_directory = entry.is_dir()
                is_file = entry.is_file()
            except OSError:
                # A dangling link is configuration the services would fail on,
                # so it is reported rather than dropped.
                found.append(entry)
                continue
            if is_directory:
                if not entry.is_symlink():
                    # Recorded as well as descended: the mode of every
                    # directory in the tree is drift worth reporting.
                    found.append(entry)
                if entry.is_symlink():
                    # Record the alias itself before deduplication can suppress
                    # it. Two links to one target are two pieces of live
                    # configuration: repointing or deleting either changes what
                    # the services read, and a re-read that reported only the
                    # first would be byte-identical across that change.
                    found.append(entry)
                descend(entry)
            elif is_file:
                found.append(entry)
            else:
                found.append(entry)

    descend(root)
    return sorted(found)


# Every directory on the way to each walked root is deployment state too:
# relaxing ~/.local/libexec/mcloving itself (or ~/.config) to 0777 leaves
# every child record byte-identical while another local user renames
# current, releases, or helpers aside and substitutes deployed code -- and
# the PHYSICAL parents of a symlinked root's resolved target permit the very
# same rename from outside the home tree. The set is derived once, by the
# shared deployment_ancestor_chain in mcloving-deploy-lib.sh (the same
# lexical-plus-physical walk the installer refuses on), and handed in by the
# wrapper above; deriving it here a second time is how the two views would
# drift apart. Enumeration is how this class of gap has happened four times.
ancestors_supplied = os.environ.get("MCLOVING_ANCESTOR_DIRS")
if ancestors_supplied is None:
    raise SystemExit(
        "mcloving-deployed-digests: MCLOVING_ANCESTOR_DIRS is not set; "
        "run this through its shell wrapper"
    )
deploy_lib = os.environ.get("MCLOVING_DEPLOY_LIB")
if deploy_lib is None:
    raise SystemExit(
        "mcloving-deployed-digests: MCLOVING_DEPLOY_LIB is not set; "
        "run this through its shell wrapper"
    )

release_entries = walk(libexec / "releases")
helper_entries = walk(libexec / "helpers")
unit_entries = [
    path
    for unit_dir in unit_dirs
    for path in walk(unit_dir)
    if path.name.startswith("mcloving-") or path in unit_dirs
]
contract_entries = walk(config)

# Every symlink the walks follow contributes its resolved target's parent
# chain, through the same shared collector the roots go through: a nested
# pki/certs -> /srv/shared/certs is followed and its bytes inventoried, but
# without this the mode or owner of /srv/shared could change while the
# document stayed byte-identical -- the ancestor class, one level down.
# Totality differs from the root chains deliberately: a nested link whose
# chain does not resolve (dangling, looping) yields an unresolvable_link_chain
# RECORD rather than failing the run, because losing the whole canonical
# document to one bad in-tree link would deny CUTOVER-001 its re-read
# precisely while drift is present. Root ancestors keep their named,
# fail-closed refusal: nothing behind a broken root chain is recordable.
chain_directories = {line for line in ancestors_supplied.splitlines() if line}
unresolvable_links = []
for link in sorted(
    {
        entry
        for entry in (
            *release_entries,
            *helper_entries,
            *unit_entries,
            *contract_entries,
        )
        if entry.is_symlink()
    }
):
    derived = subprocess.run(
        ["bash", "-ec", 'source "$0" && deployment_ancestor_chain "$1" "$2"',
         deploy_lib, str(home), str(link)],
        capture_output=True,
        text=True,
    )
    if derived.returncode != 0:
        unresolvable_links.append(link)
        continue
    chain_directories.update(
        line for line in derived.stdout.splitlines() if line
    )


def home_relative(path: Path) -> str:
    try:
        return path.relative_to(home).as_posix()
    except ValueError:
        return path.as_posix()


document = {
    "schema": "mcloving.deployed-digests/v1",
    "ancestors": [
        file_record(Path(path), home)
        for path in sorted(chain_directories)
    ]
    + [
        {"path": home_relative(link), "kind": "unresolvable_link_chain"}
        for link in unresolvable_links
    ],
    "releases": [
        file_record(path, home)
        for path in release_entries
    ],
    "helpers": [
        file_record(path, home)
        for path in helper_entries
    ],
    "current_release": (
        (libexec / "current").readlink().as_posix()
        if (libexec / "current").is_symlink()
        else None
    ),
    "previous_release": (
        (libexec / "previous").readlink().as_posix()
        if (libexec / "previous").is_symlink()
        else None
    ),
    "units": [
        # The name filter (applied when unit_entries was built) selects the
        # units this deployment owns out of a directory it shares with
        # everything else the user runs, and keeps the unit root itself:
        # `~/.config/systemd/user` is named `user`, not `mcloving-*`, so
        # repointing that live root at managed storage holding identical
        # unit bytes would otherwise leave this document unchanged while
        # systemd or Quadlet reads an entirely different tree.
        file_record(path, home)
        for path in unit_entries
    ],
    "environment_contracts": [
        file_record(path, home)
        for path in contract_entries
    ],
}

sys.stdout.write(
    json.dumps(document, sort_keys=True, indent=2, ensure_ascii=True) + "\n"
)
PY
