#!/usr/bin/env bash
# Re-read every deployed McLoving implementation identity as one canonical,
# deterministic JSON document. A future authoritative-cutover freeze
# (CUTOVER-001) consumes this output to detect drift: two invocations over
# an unchanged deployment produce byte-identical documents (no timestamps,
# sorted keys, sorted paths, home-relative paths).
#
# usage: mcloving-deployed-digests [--home DIR]
#
# Covered identities:
#   releases/*        sha256 + size of every staged binary set
#   current/previous  active and rollback release symlink targets
#   units             sha256 of every installed mcloving-* unit/quadlet file
#   config            sha256 of every file under ~/.config/mcloving
#                     (environment contracts, identity bindings, PKI); the
#                     hash commits to secret-bearing files without revealing
#                     them
set -euo pipefail

home_dir="${HOME}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --home) home_dir="${2:?}"; shift 2 ;;
    *) echo "usage: mcloving-deployed-digests [--home DIR]" >&2; exit 64 ;;
  esac
done

if [[ ! -d "${home_dir}/.local/libexec/mcloving" ]]; then
  echo "mcloving-deployed-digests: no deployment under ${home_dir}" >&2
  exit 1
fi

python3 - "${home_dir}" <<'PY'
import hashlib
import json
import stat
import sys
import os
from pathlib import Path

NODE_KINDS = {
    stat.S_IFIFO: "fifo",
    stat.S_IFSOCK: "socket",
    stat.S_IFCHR: "character_device",
    stat.S_IFBLK: "block_device",
    stat.S_IFDIR: "directory",
}

home = Path(sys.argv[1])
libexec = home / ".local/libexec/mcloving"
config = home / ".config/mcloving"
unit_dirs = (
    home / ".config/systemd/user",
    home / ".config/containers/systemd",
)


def sha256_and_size(path: Path) -> tuple[str, int]:
    # Both facts come from one open descriptor. Taking the size from a separate
    # stat() lets a file replaced or resized in between produce a record that
    # pairs the new bytes' digest with the old size -- an identity that never
    # existed, handed to CUTOVER-001 as the canonical re-read precisely during
    # a concurrent contract, helper, or release update.
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
        return digest.hexdigest(), os.fstat(handle.fileno()).st_size


def file_record(path: Path, root: Path) -> dict:
    # The services and the environment guard follow symlinks, so the re-read
    # must describe the content they actually consume. Skipping a symlinked
    # certificate, key, or contract would let a rotation or substitution of the
    # live target leave this document unchanged — a drift re-read that cannot
    # see the drift. The link target is recorded alongside the digest so a
    # repointed link is itself visible.
    if path.is_symlink() and not path.exists():
        # A target that has gone missing is exactly the drift this document
        # exists to report, so the link is recorded rather than dereferenced.
        # Hashing it would raise and produce no document at all.
        return {
            "path": path.relative_to(root).as_posix(),
            "symlink_target": os.readlink(path),
            "kind": "dangling_symlink",
        }
    if path.is_symlink() and path.is_dir():
        # A directory alias has no bytes of its own; what it names is the
        # configuration fact worth recording.
        return {
            "path": path.relative_to(root).as_posix(),
            "symlink_target": os.readlink(path),
            "kind": "directory_symlink",
        }
    def unreadable(reason: str) -> dict:
        # Losing the whole document to one unreadable entry would deny
        # CUTOVER-001 its re-read exactly when the tree is drifting underneath
        # it, and an entry that cannot be read is itself the drift worth
        # reporting. The reason is recorded so a permission change is not
        # mistaken for a disappearance.
        record = {
            "path": path.relative_to(root).as_posix(),
            "kind": "unreadable",
            "reason": reason,
        }
        if path.is_symlink():
            record["symlink_target"] = os.readlink(path)
        return record

    try:
        status = path.stat()
    except PermissionError:
        return unreadable("permission_denied")
    except OSError:
        return unreadable("stat_failed")
    if not stat.S_ISREG(status.st_mode):
        # A FIFO, socket, or device node in a deployment tree has no content to
        # digest, and opening one is not a neutral act: a FIFO with no writer
        # blocks the read forever and a socket raises. Either way the document
        # would be lost precisely when the drift it exists to report is
        # present, so the node kind is the fact recorded instead.
        record = {
            "path": path.relative_to(root).as_posix(),
            "kind": NODE_KINDS.get(stat.S_IFMT(status.st_mode), "unknown_node"),
        }
        if path.is_symlink():
            record["symlink_target"] = os.readlink(path)
        return record
    # `stat()` succeeding does not mean the bytes can be read: a contract at
    # mode 000, an ACL that withdrew access, or a file unlinked between the
    # stat above and the open below all raise here, and every one of them is
    # deployment drift rather than a reason to lose the document.
    try:
        digest, size_bytes = sha256_and_size(path)
    except PermissionError:
        return unreadable("permission_denied")
    except OSError:
        return unreadable("read_failed")
    record = {
        "path": path.relative_to(root).as_posix(),
        "sha256": digest,
        "size_bytes": size_bytes,
        # Content is not the whole identity. A binary chmod'd to 0644 keeps its
        # digest and its size while systemd can no longer execute it, so a
        # document carrying only the bytes reports no drift for a deployment
        # that has stopped working. The release manifest records
        # `executable: true` per component; without the mode here the cutover
        # re-read cannot tell that a deployed artifact no longer satisfies the
        # metadata it was verified against.
        "mode": stat.S_IMODE(status.st_mode),
        "executable": bool(status.st_mode & 0o111),
    }
    if path.is_symlink():
        record["symlink_target"] = os.readlink(path)
    return record


def walk(root: Path) -> list[Path]:
    """Every file the services can actually read beneath ``root``.

    ``rglob`` does not descend a symlinked directory, so an operator who points
    a configuration subtree such as ``pki`` at managed storage would get a
    re-read that silently omits every certificate and key inside it, while the
    services read them happily. This walks the tree the way the services see
    it, following directory links, and guards against a link cycle by
    remembering resolved directories.
    """
    found: list[Path] = []
    if root.is_symlink():
        # The root of a walked tree is live configuration in its own right.
        # Every nested alias is recorded below, but repointing ~/.config/mcloving
        # itself at another managed directory holding identical bytes would
        # otherwise leave this document unchanged -- a drift re-read blind to
        # the one substitution that redirects the whole tree. A root link whose
        # target is gone is likewise a fact the `is_dir()` check would drop.
        found.append(root)
    if not root.is_dir():
        return found
    seen: set = set()

    def descend(directory: Path) -> None:
        try:
            key = directory.resolve().as_posix()
        except OSError:
            return
        if key in seen:
            return
        seen.add(key)
        try:
            entries = sorted(directory.iterdir())
        except OSError:
            return
        for entry in entries:
            try:
                is_directory = entry.is_dir()
                is_file = entry.is_file()
            except OSError:
                # A dangling link is configuration the services would fail on,
                # so it is reported rather than dropped.
                found.append(entry)
                continue
            if is_directory:
                if entry.is_symlink():
                    # Record the alias itself before deduplication can suppress
                    # it. Two links to one target are two pieces of live
                    # configuration: repointing or deleting either changes what
                    # the services read, and a re-read that reported only the
                    # first would be byte-identical across that change.
                    found.append(entry)
                descend(entry)
            elif is_file:
                found.append(entry)
            else:
                found.append(entry)

    descend(root)
    return sorted(found)


document = {
    "schema": "mcloving.deployed-digests/v1",
    "releases": [
        file_record(path, home)
        for path in walk(libexec / "releases")
    ],
    "helpers": [
        file_record(path, home)
        for path in walk(libexec / "helpers")
    ],
    "current_release": (
        (libexec / "current").readlink().as_posix()
        if (libexec / "current").is_symlink()
        else None
    ),
    "previous_release": (
        (libexec / "previous").readlink().as_posix()
        if (libexec / "previous").is_symlink()
        else None
    ),
    "units": [
        file_record(path, home)
        for unit_dir in unit_dirs
        for path in walk(unit_dir)
        # The name filter selects the units this deployment owns out of a
        # directory it shares with everything else the user runs. It must not
        # discard the unit root itself: `~/.config/systemd/user` is named
        # `user`, not `mcloving-*`, so repointing that live root at managed
        # storage holding identical unit bytes would leave this document
        # unchanged while systemd or Quadlet reads an entirely different tree.
        if path.name.startswith("mcloving-") or path in unit_dirs
    ],
    "environment_contracts": [
        file_record(path, home)
        for path in walk(config)
    ],
}

sys.stdout.write(
    json.dumps(document, sort_keys=True, indent=2, ensure_ascii=True) + "\n"
)
PY
