#!/bin/bash
# Health verification for deployed McLoving services.
#
#   mcloving-health controller ENV_FILE   # public API answers /openapi.json
#   mcloving-health agent ENV_FILE        # journal opens, integrity ok
#
# The controller check retries within a bound so it can serve as
# ExecStartPost (startup gate); a controller that never answers fails the
# unit. The agent liveness check reads the journal, which is safe while the
# agent runs; the stronger `mcloving-agent probe` takes the journal instance
# lock and therefore only runs while the agent service is stopped (the unit
# runs it as ExecStartPre).
set -euo pipefail

usage() {
  echo "usage: mcloving-health {controller|agent} ENV_FILE [--unit UNIT]" >&2
  exit 64
}

[[ $# -ge 2 ]] || usage
service="$1"
env_file="$2"
shift 2
health_unit=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --unit)
      [[ $# -ge 2 ]] || usage
      health_unit="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

if [[ ! -f "${env_file}" ]]; then
  echo "mcloving-health: environment file ${env_file} does not exist" >&2
  exit 1
fi

libexec_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/mcloving-deploy-lib.sh"
# THE EFFECTIVE CONTRACT, through the same derivation the guard uses.
# The shipped controller unit runs this helper as ExecStartPost, so systemd
# has already composed the environment the controller was started with. A
# drop-in appending another EnvironmentFile= that overrides MCLOVING_LISTEN
# makes systemd start the controller on THAT address while this helper, when
# it reparsed only the original contract, probed the stale one -- and then
# killed a perfectly healthy controller as a startup failure. Run by hand
# (the smoke suite, an operator) nothing is composed and the parsed contract
# stands, unchanged.
# --unit means a TRANSITION is asking, from outside the unit. Its own
# environment says nothing about what the service received, so the manager
# is asked for the running service's actual environment.
#
# WHEN THE MANAGER CANNOT ANSWER, THIS REFUSES rather than falling back to
# the contract. A health check invoked here is a verdict that GATES a
# transition -- the release has already moved and the services have already
# been restarted -- and the two ways of being wrong are not symmetric. A
# derived "healthy" against a stale address is the expensive one: it
# concludes success for a deployment nobody probed. Refusing costs the
# operator a named failure at the point where the deployment is still
# recoverable, and says exactly what it could not establish. The
# --no-systemd path passes no --unit at all, because there is no unit and no
# manager by construction; there the contract IS the statement of intent and
# the probe is best-effort by design.
health_environ_file=""
if [[ -n "${health_unit}" ]]; then
  health_environ_file="$(deployment_unit_process_environment "${health_unit}")" || {
    echo "mcloving-health: cannot obtain the environment ${health_unit} is running with (the service manager did not answer, or the unit is not running); refusing to render a health verdict from the declared contract alone, because a transition has already moved the release and a probe of the wrong address would report success for a deployment nobody checked" >&2
    exit 1
  }
fi
load_effective_contract "${env_file}" "${health_environ_file}"

case "${service}" in
  controller)
    contract_into listen MCLOVING_LISTEN
    if [[ -n "${MCLOVING_CONTRACT_DROPPED[MCLOVING_LISTEN]:-}" ]]; then
      echo "mcloving-health: MCLOVING_LISTEN is declared in ${env_file} but the effective environment this unit was started with does not carry it, so the address the controller is actually listening on is unknown; reconcile the unit EnvironmentFile= declarations with ${env_file} and retry" >&2
      exit 1
    fi
    [[ -n "${listen}" ]] || {
      echo "mcloving-health: MCLOVING_LISTEN is required in ${env_file}" >&2
      exit 1
    }
    for _ in $(seq 1 120); do
      # --noproxy '*': this probe targets the local listener, so a proxy in
      # the environment would either break a healthy controller's gate or let
      # an unrelated proxy response satisfy it.
      if curl --silent --show-error --fail --max-time 3 --noproxy '*' \
        "http://${listen}/openapi.json" >/dev/null 2>&1; then
        echo "mcloving-health[controller]: public API answers on ${listen}"
        exit 0
      fi
      sleep 0.5
    done
    echo "mcloving-health[controller]: public API on ${listen} did not answer within bound" >&2
    exit 1
    ;;
  agent)
    contract_into journal MCLOVING_AGENT_JOURNAL_PATH
    if [[ -n "${MCLOVING_CONTRACT_DROPPED[MCLOVING_AGENT_JOURNAL_PATH]:-}" ]]; then
      echo "mcloving-health: MCLOVING_AGENT_JOURNAL_PATH is declared in ${env_file} but the effective environment this unit was started with does not carry it, so the journal the agent actually opened is unknown; reconcile the unit EnvironmentFile= declarations with ${env_file} and retry" >&2
      exit 1
    fi
    [[ -n "${journal}" ]] || {
      echo "mcloving-health: MCLOVING_AGENT_JOURNAL_PATH is required in ${env_file}" >&2
      exit 1
    }
    "${libexec_root}/current/mcloving-agent" journal-check "${journal}"
    echo "mcloving-health[agent]: journal at ${journal} is healthy"
    ;;
  *)
    usage
    ;;
esac
