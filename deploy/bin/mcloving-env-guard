#!/usr/bin/env bash
# Fail-closed environment-contract guard, run as ExecStartPre of every
# McLoving unit. A unit must refuse to start half-configured: any missing,
# empty, or placeholder (__SET_ME…__) variable aborts startup, as do
# contract violations the binaries would only reject after side effects.
set -euo pipefail

usage() {
  echo "usage: mcloving-env-guard {postgres|db-init|controller|agent} ENV_FILE" >&2
  exit 64
}

[[ $# -eq 2 ]] || usage
service="$1"
env_file="$2"

if [[ ! -f "${env_file}" ]]; then
  echo "mcloving-env-guard: environment file ${env_file} does not exist" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/mcloving-deploy-lib.sh"

# The deployment home anchors the ancestor walk's stop points for the
# contract itself and the configured paths below. This guard is installed
# under <home>/.local/libexec/mcloving/helpers and runs as the service
# user, so the home is derived from where the guard itself lives; a copy
# running from anywhere else falls back to the invoking user's HOME.
guard_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${guard_script_dir}" in
  */.local/libexec/mcloving/helpers)
    guard_home="${guard_script_dir%/.local/libexec/mcloving/helpers}" ;;
  *)
    guard_home="${HOME}" ;;
esac

# The contract file is judged BEFORE it is parsed. Install-time validation
# proves the state at install; a preserved contract -- an external symlink
# included -- whose file or resolved ancestor is relaxed afterwards would
# still parse cleanly at service start, so the runtime path applies the
# same treatment: the shared lexical-plus-physical ancestor walk over the
# contract's resolved chain, and the secret-file rules (contracts carry
# database passwords and tokens) on the file itself.
require_secure_ancestors "${guard_home}" "${env_file}"
require_secret_files "${EUID}" "${env_file}"

load_environment_file "${env_file}"

# require_secret_paths VAR...
#
# The configured private keys and identity bindings are stealable and
# replaceable identity material: readable-regular-file is not enough. Each
# gets the full treatment the installer gives preserved contracts --
# owner-only mode, root-or-service-uid ownership, effective readability,
# and the shared lexical-plus-physical ancestor walk over its resolved
# chain -- refusing by name with the path, mode, and uid. Certificates and
# CA bundles are public material and keep the readable-regular-file rule.
require_secret_paths() {
  local name value secret_paths=()
  for name in "$@"; do
    contract_into value "${name}"
    secret_paths+=("${value}")
  done
  require_secure_ancestors "${guard_home}" "${secret_paths[@]}"
  require_secret_files "${EUID}" "${secret_paths[@]}"
}

# require_secured_paths VAR...
#
# The integrity class for configured agent/controller state: workspace
# roots, object roots, and journals are dereferenced directly by the
# binaries, so another local user who can write them -- or any link of
# their resolved chains -- can modify workload inputs or replace durable
# journal state. Not secret-classified: the node itself must carry no
# group/other WRITE bit and be owned by root or the service user, and its
# resolved ancestor chain is walked; group/other READ stays legal (a
# journal the agent creates 0644 must not wedge the next start), and a
# journal file that does not exist yet is legal too -- its parent chain is
# still walked through the configured path.
require_secured_paths() {
  local name value mode_owner mode owner offending state_paths=()
  for name in "$@"; do
    contract_into value "${name}"
    state_paths+=("${value}")
  done
  require_secure_ancestors "${guard_home}" "${state_paths[@]}"
  offending=""
  for value in "${state_paths[@]}"; do
    [[ -e "${value}" ]] || continue
    mode_owner="$(stat -Lc '%a %u' "${value}")" \
      || fail "cannot stat configured state path ${value}"
    mode="${mode_owner%% *}"
    owner="${mode_owner##* }"
    if (( (8#${mode} & 8#022) != 0 )); then
      offending+="${value} (mode ${mode}) "
    fi
    if [[ "${owner}" != "0" && "${owner}" != "${EUID}" ]]; then
      offending+="${value} (owned by uid ${owner}, expected uid ${EUID} or root) "
    fi
  done
  if [[ -n "${offending}" ]]; then
    fail "configured state path(s) group- or world-writable or foreign-owned: ${offending% }-- another local user could rewrite workload inputs or durable state; run chmod go-w (or restore ownership) and retry"
  fi
}

fail() {
  echo "mcloving-env-guard[${service}]: $1" >&2
  exit 1
}

require() {
  local name value
  for name in "$@"; do
    contract_into value "${name}"
    if [[ -z "${value}" ]]; then
      fail "required variable ${name} is unset or empty in ${env_file}"
    fi
    if [[ "${value}" == *__SET_ME* ]]; then
      fail "variable ${name} still carries a __SET_ME…__ placeholder in ${env_file}"
    fi
  done
}

require_uuid() {
  local name value
  for name in "$@"; do
    contract_into value "${name}"
    if [[ ! "${value}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
      fail "variable ${name} must be a UUID, got ${value:-<empty>}"
    fi
  done
}

require_readable_file() {
  local name value
  for name in "$@"; do
    contract_into value "${name}"
    # -r alone accepts a directory, and a FIFO or device node too. The
    # controller and agent need a regular file they can read; reporting the
    # contract satisfied here defers the failure to the binary, or worse, to a
    # read that blocks on a special node.
    if [[ ! -f "${value}" || ! -r "${value}" ]]; then
      fail "variable ${name} must name a readable regular file; ${value:-<empty>} is not"
    fi
  done
}

require_min_bytes() {
  local name="$1" minimum="$2" value bytes
  contract_into value "${name}"
  # Bytes, not characters. ${#value} counts characters under a UTF-8 locale,
  # while the controller measures String::len(), which is the UTF-8 byte
  # length — so a valid multi-byte token would be refused here and accepted
  # there, stopping a service over a contract it could have run.
  bytes="$(printf '%s' "${value}" | wc -c)"
  if [[ "${bytes}" -lt "${minimum}" ]]; then
    fail "variable ${name} must contain at least ${minimum} bytes, got ${bytes}"
  fi
}

case "${service}" in
  postgres)
    require POSTGRES_USER POSTGRES_DB POSTGRES_PASSWORD
    ;;
  db-init)
    require MCLOVING_MIGRATION_DATABASE_URL MCLOVING_TENANT_PASSWORD \
      MCLOVING_ORGANIZATION_ID MCLOVING_ORGANIZATION_SLUG \
      MCLOVING_PROJECT_ID MCLOVING_PROJECT_SLUG \
      MCLOVING_POSTGRES_CONTAINER MCLOVING_POSTGRES_SUPERUSER \
      MCLOVING_POSTGRES_DB
    require_uuid MCLOVING_ORGANIZATION_ID MCLOVING_PROJECT_ID
    # The bootstrap uses two different connection targets for one database:
    # migrations go through MCLOVING_MIGRATION_DATABASE_URL, while the tenant
    # role and the provisioning queries go through `podman exec` against
    # MCLOVING_POSTGRES_CONTAINER / _SUPERUSER / _DB. A mistyped but reachable
    # URL therefore migrates one database and then modifies -- or fails
    # against -- another, which the contract template requires to be the same.
    contract_into migration_url MCLOVING_MIGRATION_DATABASE_URL
    contract_into postgres_db MCLOVING_POSTGRES_DB
    migration_db="$(database_url_database "${migration_url}")"
    [[ -n "${migration_db}" ]] \
      || fail "MCLOVING_MIGRATION_DATABASE_URL must name a database"
    [[ "${migration_db}" == "${postgres_db}" ]] \
      || fail "MCLOVING_MIGRATION_DATABASE_URL names database ${migration_db}, but MCLOVING_POSTGRES_DB is ${postgres_db}; the bootstrap migrates through the URL and provisions through the container, so both must name one database"
    # The database name alone does not identify an instance. The provisioning
    # half runs `podman exec` into a local container, so a URL pointing at a
    # remote host with a same-named database would have the bootstrap migrate
    # one server and then alter roles in another. The container publishes to
    # loopback, so the URL must address loopback too, and its role must be the
    # superuser the container was created with.
    database_url_is_loopback "${migration_url}" \
      || fail "MCLOVING_MIGRATION_DATABASE_URL must address the local PostgreSQL container on loopback, got host $(database_url_host "${migration_url}")"
    contract_into postgres_superuser MCLOVING_POSTGRES_SUPERUSER
    [[ "$(database_url_role "${migration_url}")" == "${postgres_superuser}" ]] \
      || fail "MCLOVING_MIGRATION_DATABASE_URL uses role $(database_url_role "${migration_url}"), but MCLOVING_POSTGRES_SUPERUSER is ${postgres_superuser}"
    ;;
  controller)
    require MCLOVING_MIGRATION_DATABASE_URL MCLOVING_DATABASE_URL \
      MCLOVING_API_TOKEN MCLOVING_ARTIFACT_AGENT_TOKEN \
      MCLOVING_LISTEN MCLOVING_OBJECT_ROOT \
      MCLOVING_ORGANIZATION_ID MCLOVING_AGENT_ID \
      MCLOVING_AGENT_CAPABILITIES MCLOVING_AGENT_TRUST_POOL \
      MCLOVING_LEASE_SECONDS MCLOVING_POLL_MILLISECONDS \
      MCLOVING_CANCELLATION_POLL_MILLISECONDS \
      MCLOVING_TERMINATION_GRACE_MILLISECONDS MCLOVING_SESSION_EPOCH \
      MCLOVING_WORKSPACE_ROOT MCLOVING_AGENT_JOURNAL \
      MCLOVING_AGENT_LISTEN MCLOVING_AGENT_SERVER_CERT_PATH \
      MCLOVING_AGENT_SERVER_KEY_PATH MCLOVING_AGENT_CLIENT_CA_PATH \
      MCLOVING_AGENT_IDENTITY_BINDINGS_PATH
    require_uuid MCLOVING_ORGANIZATION_ID
    require_min_bytes MCLOVING_API_TOKEN 32
    require_min_bytes MCLOVING_ARTIFACT_AGENT_TOKEN 32
    contract_into api_token MCLOVING_API_TOKEN
    contract_into artifact_token MCLOVING_ARTIFACT_AGENT_TOKEN
    if [[ "${api_token}" == "${artifact_token}" ]]; then
      fail "MCLOVING_API_TOKEN and MCLOVING_ARTIFACT_AGENT_TOKEN must be distinct"
    fi
    # Compare the roles the URLs authenticate as, not the URL text. Two
    # spellings of one role — a default port written out in one and omitted in
    # the other — would otherwise pass as distinct, and the controller would
    # run its runtime pool as the migration role, which is exactly what this
    # check exists to prevent.
    contract_into migration_url MCLOVING_MIGRATION_DATABASE_URL
    contract_into runtime_url MCLOVING_DATABASE_URL
    migration_role="$(database_url_role "${migration_url}")"
    runtime_role="$(database_url_role "${runtime_url}")"
    if [[ -z "${migration_role}" || -z "${runtime_role}" ]]; then
      fail "MCLOVING_MIGRATION_DATABASE_URL and MCLOVING_DATABASE_URL must each name a role"
    fi
    if [[ "${migration_role}" == "${runtime_role}" ]]; then
      fail "MCLOVING_MIGRATION_DATABASE_URL and MCLOVING_DATABASE_URL must use distinct roles, both are ${runtime_role}"
    fi
    # Distinct is not sufficient. Store::preflight_tenant_runtime requires the
    # runtime session role to be exactly MCLOVING_RUNTIME_ROLE, so a typo or a
    # second privileged role passes an inequality check here and fails after
    # the controller has already bound its listeners and run migrations. The
    # guard exists to stop that before anything starts.
    if [[ "${runtime_role}" != "${MCLOVING_RUNTIME_ROLE}" ]]; then
      fail "MCLOVING_DATABASE_URL must use the constrained ${MCLOVING_RUNTIME_ROLE} role, got ${runtime_role}"
    fi
    # Distinct roles on the same database, not two different databases. The
    # controller migrates through the first URL and then opens its runtime pool
    # through the second, so a typo in either host, port, or database name
    # modifies one instance and then fails against another -- after startup has
    # already reported the contract satisfied.
    migration_endpoint="$(database_url_endpoint "${migration_url}")"
    runtime_endpoint="$(database_url_endpoint "${runtime_url}")"
    [[ -n "${migration_endpoint}" && -n "${runtime_endpoint}" ]] \
      || fail "MCLOVING_MIGRATION_DATABASE_URL and MCLOVING_DATABASE_URL must each name a host and database"
    [[ "${migration_endpoint}" == "${runtime_endpoint}" ]] \
      || fail "MCLOVING_MIGRATION_DATABASE_URL addresses ${migration_endpoint} but MCLOVING_DATABASE_URL addresses ${runtime_endpoint}; the controller migrates through the first and runs through the second, so both must be one database"
    require_readable_file MCLOVING_AGENT_SERVER_CERT_PATH \
      MCLOVING_AGENT_SERVER_KEY_PATH MCLOVING_AGENT_CLIENT_CA_PATH \
      MCLOVING_AGENT_IDENTITY_BINDINGS_PATH
    require_secret_paths MCLOVING_AGENT_SERVER_KEY_PATH \
      MCLOVING_AGENT_IDENTITY_BINDINGS_PATH
    require_secured_paths MCLOVING_OBJECT_ROOT MCLOVING_WORKSPACE_ROOT \
      MCLOVING_AGENT_JOURNAL
    ;;
  agent)
    require MCLOVING_AGENT_ID MCLOVING_AGENT_TRUST_POOL \
      MCLOVING_AGENT_ORGANIZATION_ID MCLOVING_CONTROLLER_URI \
      MCLOVING_CONTROLLER_DNS_NAME MCLOVING_CONTROLLER_CA_PATH \
      MCLOVING_AGENT_CERTIFICATE_PATH MCLOVING_AGENT_PRIVATE_KEY_PATH \
      MCLOVING_AGENT_JOURNAL_PATH MCLOVING_AGENT_WORKSPACE_ROOT
    require_uuid MCLOVING_AGENT_ORGANIZATION_ID
    require_readable_file MCLOVING_CONTROLLER_CA_PATH \
      MCLOVING_AGENT_CERTIFICATE_PATH MCLOVING_AGENT_PRIVATE_KEY_PATH
    require_secret_paths MCLOVING_AGENT_PRIVATE_KEY_PATH
    # The agent refuses to spawn work into a missing workspace root; require
    # it up front so the unit fails at start, not at first assignment.
    contract_into workspace_root MCLOVING_AGENT_WORKSPACE_ROOT
    if [[ ! -d "${workspace_root}" ]]; then
      fail "MCLOVING_AGENT_WORKSPACE_ROOT must be an existing directory: ${workspace_root}"
    fi
    require_secured_paths MCLOVING_AGENT_WORKSPACE_ROOT \
      MCLOVING_AGENT_JOURNAL_PATH
    ;;
  *)
    usage
    ;;
esac

echo "mcloving-env-guard[${service}]: contract satisfied (${env_file})"
