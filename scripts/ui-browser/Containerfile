# Contained browser for the UI-002 gate.
#
# The gate needs a real rendering engine, and Chrome's renderer sandbox cannot
# start on hosts where AppArmor restricts unprivileged user namespaces (Ubuntu
# 23.10+, which includes the CI runners and the development hosts). Rather than
# weaken the browser in place with --no-sandbox on the host, the browser runs
# inside this container: the container's namespaces are the isolation boundary,
# and --no-sandbox applies only within it. See
# docs/architecture/UI_BROWSER_GATE_V1.md for the full argument.
#
# The base image is referenced by manifest digest, and both browser archives are
# verified against scripts/ui-browser/browser-pin.json by build-image.sh before
# they enter the build context. Nothing here downloads anything.
FROM docker.io/library/debian@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

LABEL org.opencontainers.image.title="McLoving contained UI browser gate" \
      io.mcloving.ui.gate.protocol="mcloving.ui.browser/1" \
      io.mcloving.ui.chrome.version="153.0.8010.36" \
      io.mcloving.ui.chrome.sha256="167a098c4fdec156b58a9f678c90a84f9072d789f9c6e7b35496a6987b8b7ef8" \
      io.mcloving.ui.chromedriver.sha256="c05f3bfb501b37b12b7fa2a54b8b30b51d089a64389898362aeb2785f12ac83f" \
      io.mcloving.ui.base.digest="sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171" \
      io.mcloving.ui.recipe.sha256="RECIPE_DIGEST_PLACEHOLDER"

# Chrome's shared-library closure plus python3 for the gate itself. The gate
# imports only the standard library, so no package index is consulted for it.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        ca-certificates \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libexpat1 \
        libgbm1 \
        libglib2.0-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        python3 \
        unzip \
    && rm -rf /var/lib/apt/lists/*

COPY chrome-linux64.zip chromedriver-linux64.zip /tmp/
RUN mkdir -p /opt/mcloving \
    && unzip -q /tmp/chrome-linux64.zip -d /opt/mcloving \
    && unzip -q /tmp/chromedriver-linux64.zip -d /opt/mcloving \
    && rm -f /tmp/chrome-linux64.zip /tmp/chromedriver-linux64.zip \
    && chmod 0555 /opt/mcloving/chrome-linux64/chrome \
                  /opt/mcloving/chromedriver-linux64/chromedriver \
    && /opt/mcloving/chrome-linux64/chrome --version \
    && /opt/mcloving/chromedriver-linux64/chromedriver --version

# The gate never needs to write outside its own run directory, and nothing in
# the image is owned by the runtime user.
USER 1000:1000
# Chrome aborts at startup when HOME is unwritable -- its crashpad handler is
# spawned without a database path and the browser traps on the handler's exit,
# which surfaces only as "Chrome instance exited". The runtime user owns nothing
# in the image, so point HOME at the one tree it can write.
ENV HOME=/tmp \
    MCLOVING_CHROME=/opt/mcloving/chrome-linux64/chrome \
    MCLOVING_CHROMEDRIVER=/opt/mcloving/chromedriver-linux64/chromedriver
ENTRYPOINT ["/usr/bin/python3"]
