      "find": "    byId(\"operation-result\").classList.add(\"error\");\n    byId(\"operation-result\").textContent = error.message;",
      "replace": "    byId(\"operation-result\").classList.remove(\"error\");"
    },
    {
      "name": "build-summary-never-rendered",
