FROM docker.io/jenkins/jenkins@sha256:f4f65e6cd1405cd889b7f5ac33f9d5cdc2a099de6b87fe8a3933b9c5d53d1d02

LABEL org.opencontainers.image.title="McLoving isolated Jenkins compiler worker" \
      io.mcloving.compiler.protocol="mcloving.jenkins.compiler/1" \
      io.mcloving.compiler.profile.id="mario-jenkins-oracle-228" \
      io.mcloving.compiler.profile.sha256="243e40cca38b4e789f81dbfd004470b2338b3af402e9dda97e467ee4f788bb41" \
      io.mcloving.compiler.base.digest="sha256:f4f65e6cd1405cd889b7f5ac33f9d5cdc2a099de6b87fe8a3933b9c5d53d1d02"

USER root
COPY runtime/clojure/ /opt/mcloving/lib/
COPY runtime/profile/ /opt/mcloving/profile/
COPY src/ /opt/mcloving/src/
RUN unzip -p /usr/share/jenkins/jenkins.war WEB-INF/lib/groovy-all-2.4.21.jar \
      > /opt/mcloving/lib/groovy-all-2.4.21.jar \
    && unzip -p /usr/share/jenkins/jenkins.war WEB-INF/lib/jenkins-core-2.568.1.jar \
      > /opt/mcloving/lib/jenkins-core-2.568.1.jar \
    && find /opt/mcloving -type d -exec chmod 0555 {} \; \
    && find /opt/mcloving -type f -exec chmod 0444 {} \;

USER 1000:1000
ENTRYPOINT ["/opt/java/openjdk/bin/java", "-Xms32m", "-Xmx384m", "-XX:ActiveProcessorCount=1", "-cp", "/opt/mcloving/src:/opt/mcloving/lib/*", "clojure.main", "-m", "mcloving.compat.main"]
